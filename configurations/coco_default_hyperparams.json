{
  "model": {
    "input_w": 784,
    "input_h": 784,
  },
  "training": {
    "from_pretrained": false,
    "weights_path": "./weights",

    "hyperparams": {
        "batch_size": 64,
        "epochs": 20,
        "learning_rate": 0.001
        "adam_beta1": 0.001
        "adam_beta2": 0.001
    },
  },
  "dataset": {
    "name": "coco",
    "data_dir": "./data"
  },
  "callbacks": {
    "early_stopping": {
      "monitor": "val_loss",
      "patience": 3
    },
    "checkpoint": {
      "monitor": "val_loss",
      "save_top_k": 1,
      "mode": "min"
    }
  }
}

